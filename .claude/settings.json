{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "command -v codegraph >/dev/null 2>&1 || exit 0; codegraph hook search",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|Grep"
      },
      {
        "hooks": [
          {
            "command": "command -v codegraph >/dev/null 2>&1 || exit 0; codegraph hook read",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Read|Glob"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "command -v codegraph >/dev/null 2>&1 || exit 0; codegraph index \"$CLAUDE_PROJECT_DIR\" >/dev/null 2>&1",
            "type": "command"
          },
          {
            "command": "\"$HOME\"/.claude/bin/codemap.sh \"$CLAUDE_PROJECT_DIR\" >/dev/null 2>&1",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cargo build*)",
      "Bash(cargo clippy*)",
      "Bash(cargo fmt*)",
      "Bash(cargo test*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git status*)",
      "Bash(just check)",
      "Bash(just fmt*)",
      "Bash(just lint*)",
      "Bash(just test*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(rm -rf*)"
    ]
  }
}
